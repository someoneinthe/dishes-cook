    "docs:features": "node scripts/features-document.mjs",
    "docs:check": "npm run db:diagram -- --check && npm run docs:features -- --check",
    "lint:sonar-rules": "node scripts/sonar-rules.mjs"
  },
  "private": true,
  "engines": {
    "node": ">=24",
    "npm": ">=11.10.0"
  },
