  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "lint": "expo lint",
    "lint:fix": "expo lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:ci": "jest --ci --coverage",
    "test:pocketbase": "scripts/test-pocketbase.sh",
    "server:deploy": "scripts/deploy-server.sh",
    "test:e2e": "scripts/test-e2e.sh",
    "doctor": "EXPO_DOCTOR_SKIP_DEPENDENCY_VERSION_CHECK=1 expo-doctor && node scripts/check-expo-dependencies.mjs",
